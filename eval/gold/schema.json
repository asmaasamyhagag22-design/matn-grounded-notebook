{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matn evaluation reference (silver gold) for one document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doc_id", "split", "source_sha256", "drafted_by", "body_pages", "key_points", "key_numbers"],
  "properties": {
    "schema_version": {"const": 2},
    "doc_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "split": {"enum": ["dev", "test"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drafted_by": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": "string"},
    "body_pages": {
      "description": "0-based page range that holds the document's message (e.g. without cover, contents, references, appendices). The key-point spread check runs within it; reviewers check the range and its reason.",
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "reason"],
      "properties": {
        "first": {"type": "integer", "minimum": 0},
        "last": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "numbers_note": {"type": "string", "minLength": 1, "description": "Required when there are fewer than 10 key numbers: why."},
    "notes": {"type": "string"},
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "kind", "importance", "section_path", "page_index", "page_label", "evidence_quote"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-kp-[0-9]{2}$"},
          "text": {"type": "string", "minLength": 1, "description": "Atomic, at most 30 words; every number in it must appear in evidence_quote."},
          "kind": {"enum": ["purpose", "finding", "target", "recommendation", "caveat", "definition"]},
          "importance": {"enum": [1, 2, 3], "description": "3 = must be in the brief (headline, as in the pipeline's fact schema), 2 = important, 1 = nice to have."},
          "section_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "Heading path, outermost first, as printed."},
          "page_index": {"type": "integer", "minimum": 0},
          "page_label": {"type": ["string", "null"], "description": "Printed page number (the PDF defines no /PageLabels), or null when none is printed."},
          "evidence_quote": {"type": "string", "minLength": 1},
          "quote_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["second_extractor_mismatch"]}}
        }
      }
    },
    "key_numbers": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value_as_written", "label", "unit", "source", "page_index", "page_label", "evidence_quote"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-kn-[0-9]{2}$"},
          "value_as_written": {"type": "string", "minLength": 1, "description": "Exactly as printed; must appear inside evidence_quote."},
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "unit": {"type": ["string", "null"], "description": "Unit when one is stated (%, USD bn, count, year, ...), else null."},
          "source": {"enum": ["body", "table"], "description": "Body text or a table; never text inside a chart or figure."},
          "section_path": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "page_index": {"type": "integer", "minimum": 0},
          "page_label": {"type": ["string", "null"]},
          "evidence_quote": {"type": "string", "minLength": 1},
          "quote_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["second_extractor_mismatch"]}}
        }
      }
    }
  }
}
