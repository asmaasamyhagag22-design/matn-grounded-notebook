{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matn evaluation reference (silver gold) for one document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doc_id", "split", "source_sha256", "drafted_by", "key_points", "key_numbers"],
  "properties": {
    "schema_version": {"const": 1},
    "doc_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "split": {"enum": ["dev", "test"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drafted_by": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": "string"},
    "numbers_note": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "importance", "category", "page_index", "page_label", "evidence_quote"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-kp-[0-9]{2}$"},
          "text": {"type": "string", "minLength": 1},
          "importance": {"enum": [1, 2, 3]},
          "category": {"enum": ["purpose", "finding", "conclusion", "recommendation", "caveat"]},
          "page_index": {"type": "integer", "minimum": 0},
          "page_label": {"type": ["string", "null"]},
          "evidence_quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "key_numbers": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value_as_written", "description", "page_index", "page_label", "evidence_quote"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-kn-[0-9]{2}$"},
          "value_as_written": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "page_index": {"type": "integer", "minimum": 0},
          "page_label": {"type": ["string", "null"]},
          "evidence_quote": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
