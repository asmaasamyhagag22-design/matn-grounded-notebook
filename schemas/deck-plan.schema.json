{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matn.local/schemas/deck-plan.schema.json",
  "title": "Matn deck plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "deck_title", "source_document_id", "source_filename", "language", "generation_mode", "source_scope", "validation_profile", "provenance", "slides", "omitted_claims"],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "deck_title": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_filename": {"type": "string", "minLength": 1},
    "language": {"const": "en"},
    "generation_mode": {"enum": ["validated_demo", "prepared_sample", "live_local"]},
    "source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "pdf_pages", "page_numbering"],
      "properties": {
        "section": {"type": ["string", "null"]},
        "pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "page_numbering": {"const": "physical_1_based"}
      }
    },
    "validation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_risk_claim_ids", "blocked_claim_ids", "human_verification_note"],
      "properties": {
        "accepted_risk_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "human_verification_note": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cache_status", "provenance_mode", "model_generation_calls", "cloud_fallback_enabled"],
      "properties": {
        "cache_status": {"type": "string"},
        "provenance_mode": {"type": "string"},
        "model_generation_calls": {"type": "integer", "minimum": 0},
        "inference_endpoint": {"type": ["string", "null"]},
        "cloud_fallback_enabled": {"const": false}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/slide"}
    },
    "omitted_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "reason"],
        "properties": {"claim_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 180},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_ids", "pdf_pages"],
      "properties": {
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "source_pdf_page", "crop_pdf_points", "description", "provenance_mode"],
      "properties": {
        "asset_id": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "source_pdf_page": {"type": "integer", "minimum": 1},
        "crop_pdf_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "description": {"type": "string"},
        "provenance_mode": {"const": "source_pdf_crop_no_ocr"}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "slide_number", "title", "purpose", "layout", "bullets", "citations", "visual_asset", "speaker_notes", "validation_status"],
      "properties": {
        "slide_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "slide_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "layout": {"enum": ["title", "title_and_bullets", "two_columns", "three_columns", "process", "image_and_caption", "takeaways", "sources"]},
        "bullets": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/bullet"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "visual_asset": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/asset"}]},
        "speaker_notes": {"type": ["string", "null"]},
        "validation_status": {"enum": ["validated", "pending", "failed"]}
      }
    }
  }
}
