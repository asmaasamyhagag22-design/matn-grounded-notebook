{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matn.local/schemas/manifest.schema.json",
  "title": "Matn extraction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_run_id",
    "run_status",
    "source",
    "extractor",
    "requested_pdf_pages",
    "timing",
    "environment",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "extraction_run_id": {"type": "string", "format": "uuid"},
    "run_status": {"const": "completed"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size_bytes", "sha256", "page_count"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "settings"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "settings": {"type": "object"}
      }
    },
    "requested_pdf_pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "pdf_pages", "page_indices", "numbering"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "pdf_pages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "page_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "numbering": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "elapsed", "unit", "clock", "scope"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "elapsed": {"type": "number", "minimum": 0},
        "unit": {"const": "seconds"},
        "clock": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "pdf_page",
          "page_label",
          "printed_page",
          "text_path",
          "text_char_count",
          "extraction_status",
          "human_review",
          "signals",
          "warnings",
          "error"
        ],
        "properties": {
          "page_index": {"type": "integer", "minimum": 0},
          "pdf_page": {"type": "integer", "minimum": 1},
          "page_label": {"type": ["string", "null"]},
          "printed_page": {"type": "null"},
          "text_path": {"type": "string", "pattern": "^page_[0-9]{4}\\.(txt|md)$"},
          "text_char_count": {"type": "integer", "minimum": 0},
          "extraction_status": {"enum": ["text_present", "no_text"]},
          "human_review": {"const": "not_performed"},
          "signals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_count", "drawing_count"],
            "properties": {
              "image_count": {"type": ["integer", "null"], "minimum": 0},
              "drawing_count": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "warnings": {"type": "array", "items": {"type": "string"}},
          "error": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "message"],
                "properties": {
                  "type": {"type": "string"},
                  "message": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    }
  }
}
