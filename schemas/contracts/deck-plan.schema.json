{
  "$defs": {
    "ChartSpec": {
      "additionalProperties": false,
      "properties": {
        "chart_type": {
          "$ref": "#/$defs/ChartType"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "x_column": {
          "minimum": 0,
          "title": "X Column",
          "type": "integer"
        },
        "y_columns": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Y Columns",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "x_column",
        "y_columns",
        "chart_type"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "ChartType": {
      "enum": [
        "bar",
        "column",
        "line"
      ],
      "title": "ChartType",
      "type": "string"
    },
    "Slide": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SlideItem"
          },
          "maxItems": 4,
          "title": "Items",
          "type": "array"
        },
        "kpi_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kpi Fact Ids",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slide_type": {
          "$ref": "#/$defs/SlideType"
        },
        "title": {
          "maxLength": 90,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slide_type",
        "title",
        "notes"
      ],
      "title": "Slide",
      "type": "object"
    },
    "SlideItem": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "title": "SlideItem",
      "type": "object"
    },
    "SlideType": {
      "enum": [
        "title",
        "executive_summary",
        "kpi",
        "finding",
        "chart",
        "implications",
        "limitations",
        "sources"
      ],
      "title": "SlideType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "doc_id": {
      "pattern": "^sha256-[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/Slide"
      },
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "doc_id",
    "slides"
  ],
  "title": "DeckPlan",
  "type": "object"
}
