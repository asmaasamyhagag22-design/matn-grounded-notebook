{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char Start"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "quote",
        "char_start",
        "char_end"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FactKind": {
      "enum": [
        "purpose",
        "finding",
        "target",
        "recommendation",
        "caveat",
        "definition",
        "number"
      ],
      "title": "FactKind",
      "type": "string"
    },
    "FactStatus": {
      "enum": [
        "raw",
        "verified",
        "rejected"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "Importance": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Importance",
      "type": "integer"
    },
    "NumberFactValue": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Label"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value_as_written": {
          "minLength": 1,
          "title": "Value As Written",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value_as_written",
        "unit",
        "page_label"
      ],
      "title": "NumberFactValue",
      "type": "object"
    },
    "RejectReason": {
      "enum": [
        "quote_not_found",
        "invalid_evidence_span",
        "number_not_in_evidence",
        "unsupported_statement",
        "attribution_mismatch",
        "hedge_mismatch",
        "evidence_hidden",
        "evidence_in_figure",
        "spelled_number_mismatch"
      ],
      "title": "RejectReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attributed_to": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attributed To"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "fact_id": {
      "pattern": "^fact:[0-9a-f]{16}$",
      "title": "Fact Id",
      "type": "string"
    },
    "importance": {
      "$ref": "#/$defs/Importance"
    },
    "kind": {
      "$ref": "#/$defs/FactKind"
    },
    "number_value": {
      "anyOf": [
        {
          "$ref": "#/$defs/NumberFactValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "reject_reasons": {
      "items": {
        "$ref": "#/$defs/RejectReason"
      },
      "title": "Reject Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FactStatus"
    }
  },
  "required": [
    "fact_id",
    "kind",
    "statement",
    "attributed_to",
    "evidence",
    "importance",
    "status",
    "reject_reasons",
    "number_value"
  ],
  "title": "Fact",
  "type": "object"
}
