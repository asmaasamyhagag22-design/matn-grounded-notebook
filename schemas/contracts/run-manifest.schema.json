{
  "$defs": {
    "ExtractorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ExtractorInfo",
      "type": "object"
    },
    "PromptVersion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PromptVersion",
      "type": "object"
    },
    "SamplingParameters": {
      "additionalProperties": false,
      "properties": {
        "num_ctx": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Num Ctx"
        },
        "num_predict": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Num Predict"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seed"
        },
        "temperature": {
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top P"
        }
      },
      "required": [
        "temperature",
        "seed",
        "top_p",
        "num_ctx",
        "num_predict"
      ],
      "title": "SamplingParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Commit",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "extractor": {
      "$ref": "#/$defs/ExtractorInfo"
    },
    "model_digest": {
      "minLength": 1,
      "title": "Model Digest",
      "type": "string"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "prompt_versions": {
      "items": {
        "$ref": "#/$defs/PromptVersion"
      },
      "title": "Prompt Versions",
      "type": "array"
    },
    "sampling_parameters": {
      "$ref": "#/$defs/SamplingParameters"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "commit",
    "model_name",
    "model_digest",
    "prompt_versions",
    "sampling_parameters",
    "extractor",
    "started_at",
    "completed_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
