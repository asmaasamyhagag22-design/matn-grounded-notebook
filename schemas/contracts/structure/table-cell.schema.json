      "type": "integer"
    },
    "row_span": {
      "default": 1,
      "minimum": 1,
      "title": "Row Span",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
