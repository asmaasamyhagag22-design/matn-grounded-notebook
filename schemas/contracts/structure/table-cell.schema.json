          "title": "Frame",
          "type": "string"
        },
        "interpolated": {
          "default": false,
          "title": "Interpolated",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "coordinates",
        "bbox_precision"
