{
  "$defs": {
    "BBoxRef": {
      "additionalProperties": false,
      "properties": {
        "bbox_precision": {
          "enum": [
            "char",
            "word",
            "line",
            "region"
          ],
          "title": "Bbox Precision",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "frame": {
          "default": "pdf_points",
          "enum": [
            "pdf_points",
            "reader_points"
          ],
          "title": "Frame",
          "type": "string"
        },
        "interpolated": {
          "default": false,
          "title": "Interpolated",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "coordinates",
        "bbox_precision"
      ],
      "title": "BBoxRef",
      "type": "object"
    },
    "BlockSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "boxes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BBoxRef"
          },
          "title": "Boxes",
          "type": "array"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "BlockSpan",
      "type": "object"
    },
    "NumberTokenRef": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxRef"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "chunk_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk End"
        },
        "chunk_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Start"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "pdf_page_index": {
          "minimum": 0,
          "title": "Pdf Page Index",
          "type": "integer"
        },
        "reader1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader1"
        },
        "reader2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader2"
        },
        "reader_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBoxRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reader_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Ref"
        },
        "reader_source": {
          "enum": [
            "digital",
            "ocr"
          ],
          "title": "Reader Source",
          "type": "string"
        },
        "reader_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Status"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "enum": [
            "digital",
            "accepted",
            "flagged",
            "flagged-unlinked"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reader_source",
        "status",
        "text",
        "pdf_page_index",
        "block_id",
        "start",
        "end",
        "bbox"
      ],
      "title": "NumberTokenRef",
      "type": "object"
    },
    "StructureIssue": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "pdf_page_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page Index"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StructureIssue",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxRef"
        },
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "col_span": {
          "default": 1,
          "minimum": 1,
          "title": "Col Span",
          "type": "integer"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        },
        "numeric_tokens": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NumberTokenRef"
          },
          "title": "Numeric Tokens",
          "type": "array"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "minimum": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "row",
        "col",
        "text",
        "bbox"
      ],
      "title": "TableCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "$ref": "#/$defs/BBoxRef"
    },
    "block_ids": {
      "items": {
        "type": "string"
      },
      "title": "Block Ids",
      "type": "array"
    },
    "cells": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TableCell"
      },
      "title": "Cells",
      "type": "array"
    },
    "cols": {
      "default": 0,
      "minimum": 0,
      "title": "Cols",
      "type": "integer"
    },
    "doc_id": {
      "pattern": "^sha256-[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "header_rows": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Header Rows",
      "type": "array"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StructureIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "pdf_page_index": {
      "minimum": 0,
      "title": "Pdf Page Index",
      "type": "integer"
    },
    "producer_version": {
      "default": "r-lite-1",
      "title": "Producer Version",
      "type": "string"
    },
    "rows": {
      "default": 0,
      "minimum": 0,
      "title": "Rows",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "structure": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Structure",
      "type": "string"
    },
    "table_id": {
      "title": "Table Id",
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "table_id",
    "doc_id",
    "pdf_page_index",
    "bbox",
    "block_ids",
    "structure"
  ],
  "title": "Table",
  "type": "object"
}
