{
  "$defs": {
    "BBoxRef": {
      "additionalProperties": false,
      "properties": {
        "bbox_precision": {
          "enum": [
            "char",
            "word",
            "line",
            "region"
          ],
          "title": "Bbox Precision",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "frame": {
          "default": "pdf_points",
          "enum": [
            "pdf_points",
            "reader_points"
          ],
          "title": "Frame",
          "type": "string"
        },
        "interpolated": {
          "default": false,
          "title": "Interpolated",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "coordinates",
        "bbox_precision"
      ],
      "title": "BBoxRef",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "block_type": {
          "$ref": "#/$defs/BlockType"
        },
        "doc_id": {
          "pattern": "^sha256-[0-9a-f]{64}$",
          "title": "Doc Id",
          "type": "string"
        },
        "extractor": {
          "$ref": "#/$defs/ExtractorInfo"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Label"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "route": {
          "$ref": "#/$defs/ExtractionRoute"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "style": {
          "$ref": "#/$defs/BlockStyle"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "visibility_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HiddenReason"
          },
          "title": "Visibility Reasons",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "doc_id",
        "page_index",
        "page_label",
        "bbox",
        "block_type",
        "text",
        "reading_order",
        "style",
        "extractor",
        "route",
        "visibility"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "boxes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BBoxRef"
          },
          "title": "Boxes",
          "type": "array"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "BlockSpan",
      "type": "object"
    },
    "BlockStyle": {
      "additionalProperties": false,
      "properties": {
        "font_size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Font Size Pt"
        },
        "is_bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Is Bold"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "font_size_pt",
        "is_bold"
      ],
      "title": "BlockStyle",
      "type": "object"
    },
    "BlockType": {
      "enum": [
        "text",
        "heading",
        "list_item",
        "table",
        "figure",
        "caption",
        "header",
        "footer",
        "footnote"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "ExtractionRoute": {
      "enum": [
        "text_layer",
        "ocr"
      ],
      "title": "ExtractionRoute",
      "type": "string"
    },
    "ExtractorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ExtractorInfo",
      "type": "object"
    },
    "HiddenReason": {
      "enum": [
        "invisible_render_mode",
        "covered_by_image",
        "covered_by_vector",
        "fill_matches_background",
        "outside_cropbox",
        "near_zero_size",
        "clipped",
        "partial_ink",
        "no_ink_unexplained"
      ],
      "title": "HiddenReason",
      "type": "string"
    },
    "NumberTokenRef": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxRef"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "chunk_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk End"
        },
        "chunk_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Start"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "pdf_page_index": {
          "minimum": 0,
          "title": "Pdf Page Index",
          "type": "integer"
        },
        "reader1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader1"
        },
        "reader2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader2"
        },
        "reader_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBoxRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reader_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Ref"
        },
        "reader_source": {
          "enum": [
            "digital",
            "ocr"
          ],
          "title": "Reader Source",
          "type": "string"
        },
        "reader_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Status"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "enum": [
            "digital",
            "accepted",
            "flagged",
            "flagged-unlinked"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reader_source",
        "status",
        "text",
        "pdf_page_index",
        "block_id",
        "start",
        "end",
        "bbox"
      ],
      "title": "NumberTokenRef",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "visible",
        "hidden",
        "uncertain"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "$ref": "#/$defs/BBoxRef"
    },
    "block": {
      "$ref": "#/$defs/Block"
    },
    "citable": {
      "title": "Citable",
      "type": "boolean"
    },
    "exclusion_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusion Reasons",
      "type": "array"
    },
    "flags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "number_tokens": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NumberTokenRef"
      },
      "title": "Number Tokens",
      "type": "array"
    },
    "reader_frame": {
      "default": "pdf_points",
      "title": "Reader Frame",
      "type": "string"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_spans": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BlockSpan"
      },
      "title": "Source Spans",
      "type": "array"
    }
  },
  "required": [
    "block",
    "role",
    "citable",
    "bbox"
  ],
  "title": "Element",
  "type": "object"
}
