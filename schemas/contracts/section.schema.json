{
  "$defs": {
    "PageRange": {
      "additionalProperties": false,
      "properties": {
        "first_page_index": {
          "minimum": 0,
          "title": "First Page Index",
          "type": "integer"
        },
        "last_page_index": {
          "minimum": 0,
          "title": "Last Page Index",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "first_page_index",
        "last_page_index"
      ],
      "title": "PageRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "block_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Block Ids",
      "type": "array"
    },
    "doc_id": {
      "pattern": "^sha256-[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "heading_path": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Heading Path",
      "type": "array"
    },
    "level": {
      "minimum": 1,
      "title": "Level",
      "type": "integer"
    },
    "page_range": {
      "$ref": "#/$defs/PageRange"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "section_id": {
      "title": "Section Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "section_id",
    "doc_id",
    "title",
    "level",
    "heading_path",
    "block_ids",
    "page_range"
  ],
  "title": "Section",
  "type": "object"
}
