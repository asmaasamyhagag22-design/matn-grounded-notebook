{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matn.local/schemas/summary-result.schema.json",
  "title": "Matn Phase 03 grounded summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary_title", "summary_points", "key_numbers", "key_terms", "limitations", "coverage_notice", "available_claim_ids", "selected_claim_ids", "omitted_claim_ids", "omission_reason", "source_topic_coverage", "numeric_coverage", "terminology_coverage", "limitations_coverage", "coverage_warnings", "coverage_status", "source_content_risk_flags", "source_selection_id", "document_id"],
  "properties": {
    "schema_version": {"const": 1},
    "summary_title": {"type": "string", "minLength": 1},
    "summary_points": {
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["point_text", "claim_ids", "citations", "provenance"],
        "properties": {
          "point_text": {"type": "string", "minLength": 1, "maxLength": 10000},
          "section": {"type": "string"},
          "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "citations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["pdf_page", "page_label", "printed_page", "display"],
              "properties": {
                "pdf_page": {"type": "integer", "minimum": 1},
                "page_label": {"type": ["string", "null"]},
                "printed_page": {"type": ["string", "integer", "null"]},
                "display": {"type": "string"}
              }
            }
          },
          "provenance": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim_id", "evidence"],
              "properties": {
                "claim_id": {"type": "string"},
                "evidence": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["source_chunk_id", "short_quote"],
                    "properties": {
                      "source_chunk_id": {"type": "string"},
                      "short_quote": {"type": "string"},
                      "exact_text": {"type": "string"},
                      "start_offset": {"type": "integer"},
                      "end_offset": {"type": "integer"},
                      "pdf_page": {"type": "integer"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "key_numbers": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["value", "claim_ids"], "properties": {"value": {"type": "string", "maxLength": 160}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "key_terms": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["term", "explanation", "claim_ids"], "properties": {"term": {"type": "string", "maxLength": 160}, "explanation": {"type": "string", "maxLength": 500}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "limitations": {"type": "array", "maxItems": 80, "items": {"type": "object", "additionalProperties": false, "required": ["text", "claim_ids"], "properties": {"text": {"type": "string", "maxLength": 1000}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "claim_renderings": {"type": "object", "additionalProperties": {"type": "string"}},
    "coverage_notice": {"type": "string"},
    "available_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "omitted_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "omission_reason": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_topic_coverage": {"type": "object"},
    "numeric_coverage": {"type": "object"},
    "terminology_coverage": {"type": "object"},
    "limitations_coverage": {"type": "object"},
    "coverage_warnings": {"type": "array", "items": {"type": "string"}},
    "comprehensive_requested": {"type": "boolean"},
    "semantic_plan_sha256": {"type": ["string", "null"]},
    "parity_validation": {"type": ["object", "null"]},
    "coverage_status": {"type": "object", "additionalProperties": false, "required": ["text_supported", "limited_by_table_extraction", "limited_by_equation_extraction", "limited_by_picture_content", "human_review_required"], "properties": {"text_supported": {"type": "boolean"}, "limited_by_table_extraction": {"type": "boolean"}, "limited_by_equation_extraction": {"type": "boolean"}, "limited_by_picture_content": {"type": "boolean"}, "human_review_required": {"type": "boolean"}}},
    "source_content_risk_flags": {"type": "array", "items": {"type": "string"}},
    "source_selection_id": {"type": "string"},
    "document_id": {"type": "string"}
  }
}
