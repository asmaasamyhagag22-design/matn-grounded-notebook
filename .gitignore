# ---- Step 0 foundation: never commit these ----
# Virtual environments (".venv*/" already covers .venv and .venv-offline)
venv/
env/
.conda/
node_modules
**/node_modules/
# Model files and runtime data
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.bin
.ollama/
models/
# Caches
*.py[cod]
.mypy_cache/
.ruff_cache/
.cache/
*-cache/
.*-cache/
# Run outputs ("output/", "outputs/", "tmp/" already ignored)
runs/
# Generated decks and machine-specific diagnostics (document text / local paths)
*.pptx
codeintegrity-events.txt
pymupdf-environment.txt
pymupdf_failures.txt
pymupdf_recovery_validation.txt
# Commercial book and anything derived from it (moved out of the repo; ignored if it ever returns)
*Z-Library*
*Raschka*
**/book-*/
**/*book-demo*/
pre-demo-backup/
_quarantine*/
# Secrets
.env
.env.*
*.pem
*.key
.streamlit/secrets.toml
# Audit working files stay local; the report, findings and diffs are committed
audit/scratch/
audit/logs/
# Evaluation inputs stay local (sha256 pinned in eval/registry.json); "*.pdf" already ignores the PDFs
eval/pages/
# Old renderer v0 specimen output (local only; specimen v2 renders into out/gallery/)
design/specimen/*.pptx
design/specimen/png/
# Gallery templates are source files: their .pptx and thumbnail are committed (G1 allows .pptx only here)
!design/templates/**/*.pptx
!design/templates/**/thumbnail.png
# Generated gallery previews and contact sheets
out/

# Public repository: evaluation gold for the sealed split stays private.
eval/gold/test/
# Package archives and local runtimes
*.whl
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
**/wheelhouse*/
**/.venv*/
**/venv*/
