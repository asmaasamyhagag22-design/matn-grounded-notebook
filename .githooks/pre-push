#!/bin/sh
# Matn pre-push hook (G4: full test suite, slow tests included). Logic lives in pre_push.py.
HOOK_DIR=$(dirname "$0")
PY="$MATN_PYTHON"
[ -z "$PY" ] && [ -x ".venv/Scripts/python.exe" ] && PY=".venv/Scripts/python.exe"
[ -z "$PY" ] && [ -x ".venv/bin/python" ] && PY=".venv/bin/python"
[ -z "$PY" ] && command -v python3 >/dev/null 2>&1 && PY=python3
[ -z "$PY" ] && PY=python
PYTHONDONTWRITEBYTECODE=1 exec "$PY" "$HOOK_DIR/pre_push.py" "$@"
